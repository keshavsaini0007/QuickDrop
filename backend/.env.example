NODE_ENV=development
PORT=4000
API_PREFIX=/api
TRUST_PROXY=false
CLIENT_ORIGINS=http://localhost:8081,http://localhost:19006
PUBLIC_WEB_BASE_URL=http://localhost:4000
APP_DEEP_LINK_SCHEME=quickdrop

MONGODB_URI=mongodb://127.0.0.1:27017/quickdrop
MONGODB_DB_NAME=quickdrop

JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=quickdrop
JWT_AUDIENCE=quickdrop-api
REFRESH_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_EXPIRES_DAYS=30
SHARE_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
JWT_SHARE_SECRET=replace-with-at-least-32-random-bytes
SHARE_ACCESS_EXPIRES_MINUTES=15
SHARE_MAX_EXPIRY_DAYS=365
SHARE_PASSWORD_MIN_LENGTH=6

BCRYPT_SALT_ROUNDS=12
STORAGE_LIMIT_BYTES=5368709120
TRASH_RETENTION_DAYS=30
UPLOAD_SESSION_TTL_MINUTES=60
UPLOAD_SESSION_RETENTION_DAYS=7
MAINTENANCE_INTERVAL_MINUTES=60
UPLOAD_CHUNK_SIZE_MB=10
UPLOAD_CHUNK_THRESHOLD_MB=20
MAX_IMAGE_SIZE_MB=25
MAX_VIDEO_SIZE_MB=500
MAX_DOCUMENT_SIZE_MB=100
MAX_TEXT_SIZE_MB=10

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER_PREFIX=quickdrop
CLOUDINARY_UPLOAD_TIMEOUT_MS=120000
CLOUDINARY_DELIVERY_TYPE=authenticated
CLOUDINARY_THUMBNAIL_TRANSFORMATION=c_fill,w_400,h_400,q_auto,f_jpg

LOG_LEVEL=info
LOG_PRETTY=true
MONGOOSE_DEBUG=false

RATE_LIMIT_GLOBAL_WINDOW_MINUTES=15
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_UPLOAD_WINDOW_MINUTES=60
RATE_LIMIT_UPLOAD_MAX=60
RATE_LIMIT_PUBLIC_WINDOW_MINUTES=1
RATE_LIMIT_PUBLIC_MAX=60

RESET_TOKEN_TTL_MINUTES=60
DEV_EXPOSE_RESET_TOKEN=false
EMAIL_PROVIDER=console
EMAIL_FROM=QuickDrop <no-reply@example.com>
RESEND_API_KEY=

APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.quickdrop.app
ANDROID_PACKAGE_NAME=com.quickdrop.app
ANDROID_SHA256_CERT_FINGERPRINT=
