# Public values only. Never put secrets in EXPO_PUBLIC_* variables.
# For a physical device, replace localhost with your computer's LAN IP,
# or use an HTTPS tunnel. Android emulator commonly uses 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_SHARE_BASE_URL=http://localhost:4000
EXPO_PUBLIC_APP_SCHEME=quickdrop
EXPO_PUBLIC_APP_NAME=QuickDrop
