{
  "expo": {
    "name": "QuickDrop",
    "slug": "quickdrop",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "quickdrop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.quickdrop.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.quickdrop.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES", "READ_MEDIA_VIDEO", "POST_NOTIFICATIONS"]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F766E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow QuickDrop to use Face ID to unlock your vault."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow QuickDrop to use Face ID to unlock your vault."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow QuickDrop to select photos and videos to upload.",
          "cameraPermission": "Allow QuickDrop to take photos to upload."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0F766E"
        }
      ],
      "expo-sharing",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
